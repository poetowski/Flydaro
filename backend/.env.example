# Local dev defaults match docker-compose.yml at the repo root.
# For Neon, use the pooled connection string for DATABASE_URL and the
# direct/unpooled one for DATABASE_URL_DIRECT (see plan's Neon pooling note).
# Neon's dashboard copies connection strings with `?sslmode=require`, which
# asyncpg does not understand -- replace it with `?ssl=require`.
DATABASE_URL=postgresql+asyncpg://flydaro:flydaro@localhost:5432/flydaro
DATABASE_URL_DIRECT=postgresql+asyncpg://flydaro:flydaro@localhost:5432/flydaro

JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list is not supported directly by pydantic-settings' list
# parsing from env vars in JSON form; set as a JSON array string, e.g.:
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

SIGNUP_BONUS_CREDITS=2000

# Register an OAuth2 client at https://opensky-network.org/my-opensky to get these.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
POLLER_INTERVAL_SECONDS=60

# Leave both false locally -- run `alembic upgrade head` and
# `python -m app.worker.main` as separate steps/processes instead (see
# README). These exist for single-service deployments (e.g. Render free
# tier) that have no separate worker process and no pre-deploy step.
RUN_MIGRATIONS_ON_STARTUP=false
RUN_POLLER_IN_API=false
